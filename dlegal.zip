on: relative;}.big_header_block {padding: 2em; position: relative; overflow: hidden;}.banner_appicon {grid-area: appicon; width: 48px; height: 48px;}.banner_apptitle {grid-area: title;}.banner_screenshot {grid-area: screenshot; width: 300px; height: auto; margin: 0 auto;}.banner_desc {grid-area: desc;}.banner_links {grid-area: link; display: flex; align-items: center;}.banner_apptitle h2, .banner_apptitle p, .banner_desc h3, .banner_desc p {color: #fff; margin: 0; padding: 0;}.banner_apptitle h2 {font-size: 18px;}.banner_apptitle p, .banner_desc h3 {font-size: 16px;}.banner_background {position: absolute; top: -50px; left: 0; z-index: 0;}.banner_links .dldbtnsm {margin: 0;}.banner_learnmore {color: #fff !important; font-size: 14px; padding: 10px 20px; text-decoration: underline;}';document.getElementsByTagName("head")[0].appendChild(banner_css);if(agt.match(/Macintosh/i)){var bannerBtnVP=document.getElementById('banner_btn_vp');var bannerBtnWP=document.getElementById('banner_btn_wp');if(bannerBtnVP&&bannerBtnWP){bannerBtnVP.href='components/vpmacu.zip';bannerBtnWP.href='components/wavepadmacu.zip'}}
